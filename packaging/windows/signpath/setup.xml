<?xml version="1.0" encoding="utf-8"?>
<!-- SignPath artifact configuration "setup": the Inno Setup installer, built after the exes
     inside it were signed. Reference copy of what is configured on signpath.io. -->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <parameters>
    <parameter name="version" required="true" />
  </parameters>
  <zip-file>
    <pe-file path="zunder-windows-setup.exe" product-name="zunder" product-version="${version}">
      <authenticode-sign />
    </pe-file>
  </zip-file>
</artifact-configuration>
