# Maintainer: Elyes Ghazel <elyes@elyesghazel.ch>
pkgname=zunder-bin
_pkgname=zunder
pkgver=0.2.6
pkgrel=1
pkgdesc='Terminal-styled launcher and ALT+TAB window switcher for Hyprland (prebuilt)'
arch=('x86_64')
url='https://github.com/elyesghazel/zunder'
license=('MIT')
depends=('gtk4' 'gtk4-layer-shell' 'wl-clipboard' 'hyprland' 'glibc' 'gcc-libs')
optdepends=(
  'grim: window previews in ALT+TAB'
  'cliphist: clipboard history'
  'fd: file search'
  'curl: currency conversion'
  'ttf-jetbrains-mono-nerd: default font and glyphs'
)
provides=('zunder')
conflicts=('zunder')
source=("$_pkgname-$pkgver.tar.gz::$url/releases/download/v$pkgver/$_pkgname-$pkgver-x86_64-linux.tar.gz")
sha256sums=('SKIP')

package() {
  cd "$_pkgname-$pkgver"
  install -Dm755 zunder "$pkgdir/usr/bin/zunder"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$_pkgname/README.md"
  cp -r docs "$pkgdir/usr/share/doc/$_pkgname/"
  install -Dm755 -t "$pkgdir/usr/share/$_pkgname/plugins" examples/plugins/*
  install -Dm644 assets/logo.svg "$pkgdir/usr/share/icons/hicolor/scalable/apps/zunder.svg"
  for size in 16 22 24 32 48 64 128 256 512; do
    install -Dm644 "assets/icons/zunder-$size.png" "$pkgdir/usr/share/icons/hicolor/${size}x${size}/apps/zunder.png"
  done
}
