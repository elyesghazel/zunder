#!/usr/bin/env python3
# Search running processes; Enter kills the selected one.
# @zunder.name   Kill Process
# @zunder.prefix kill
# @zunder.glyph  
import json, subprocess, sys

query = sys.argv[1].lower() if len(sys.argv) > 1 else ""
ps = subprocess.run(["ps", "-u", str(__import__("os").getuid()), "-o", "pid=,%cpu=,rss=,comm="],
                    capture_output=True, text=True).stdout
rows = []
for line in ps.splitlines():
    pid, cpu, rss, comm = line.split(None, 3)
    if query in comm.lower():
        rows.append((float(cpu), pid, int(rss) // 1024, comm))
for cpu, pid, mb, comm in sorted(rows, reverse=True)[:40]:
    print(json.dumps({"title": comm, "subtitle": f"pid {pid}", "hint": f"{cpu:.0f}% · {mb} MB",
                      "action": {"run": f"kill {pid}"}}))
